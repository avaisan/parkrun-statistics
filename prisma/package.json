{
    "name": "@parkrun/prisma",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "scripts": {
      "build": "prisma generate",
      "migrate": "prisma migrate deploy --config ../prisma.config.ts",
      "reset": "prisma migrate reset --force --config ../prisma.config.ts",
      "studio": "prisma studio --config ../prisma.config.ts",
      "generate": "prisma generate",
      "clean": "node -e \"require('node:fs').rmSync('../scraper/src/generated', { recursive: true, force: true })\"",
      "lint": "eslint ."
    },
    "devDependencies": {},
    "dependencies": {}
  }
