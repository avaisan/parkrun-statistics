// Prisma 7 "prisma-client" generator. Only the scraper uses the client, so it is generated there
// (gitignored; created by `npm run build` or `npm run generate -w prisma`).
generator client {
  provider            = "prisma-client"
  output              = "../scraper/src/generated/prisma"
  importFileExtension = "js" // scraper compiles with moduleResolution "nodenext"
  previewFeatures     = ["views"] // still a preview feature in Prisma 7.10
}

datasource db {
  provider = "postgresql"
}

model Event {
  id                    Int      @id @default(autoincrement())
  eventId               Int
  eventName             String
  eventCountry          String
  eventDate             DateTime
  finishTimes           Int[]
  avgFinishTimeInMin    Float
  fastestFinishTimeInMin Float
  createdAt             DateTime @default(now())

  @@unique([eventName, eventId])
}

view EventQuarterlyStats {
  eventName          String
  eventCountry       String
  year               Int
  quarter            Int
  fastest_time        Float    // Fastest single time in the quarter
  fastest_quartile    Float    // Average of the fastest 25% times
  avg_finish_time      Float    // Average finish time
  slowest_quartile    Float    // Average of the slowest 25% times
  avg_participants    Float    // Average number of participants

  @@unique([eventName, year, quarter])
  @@map("event_quarterly_stats")
}