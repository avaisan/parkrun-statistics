{
  "name": "@parkrun/root",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "prisma",
    "frontend",
    "scraper",
    "api",
    "cdk"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "db": "docker compose up -d postgres",
    "db:migrate": "npx prisma migrate deploy",
    "db:reset": "docker compose down -v && docker compose up -d postgres && npx prisma migrate reset --force",
    "db:studio": "npx prisma studio",
    "scraper": "npm -w scraper run scraper --",
    "frontend": "npm run ui -w frontend",
    "api": "npm run api -w api",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w api",
    "test:frontend": "npm run test -w frontend",
    "start": "docker compose up",
    "start:db": "docker compose up -d postgres",
    "stop": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  },
  "allowScripts": {
    "esbuild": true,
    "prisma": true,
    "@prisma/engines": true
  }
}
