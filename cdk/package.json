{
  "name": "@parkrun/cdk",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint .",
    "cdk": "cdk",
    "deploy": "cdk deploy --all",
    "clean": "node -e \"for (const p of ['build', 'cdk.out', '.cdk.staging']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "destroy": "cdk destroy --all"
  },
  "devDependencies": {
    "aws-cdk": "2.1148.0"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "^10.8.1"
  }
}
