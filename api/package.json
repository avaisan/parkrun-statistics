{
    "name": "@parkrun/api",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc && node -e \"require('node:fs').copyFileSync('package.json', 'dist/package.json')\"",
        "api": "tsx src/server.ts",
        "lint": "eslint .",
        "clean": "node -e \"for (const p of ['dist', 'build', 'function.zip']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
        "test": "vitest run"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1164.0",
        "cors": "^2.8.6",
        "express": "^5.3.0"
    },
    "devDependencies": {
        "@types/aws-lambda": "^8.10.164",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/supertest": "^7.2.1",
        "supertest": "^7.3.2"
    }
}
